# 智能运维 Agent 环境变量配置

# --- DolphinScheduler ---
DS_HOST=localhost
DS_PORT=12345
DS_TOKEN=your_ds_token_here

# --- LLM ---
APP_LLM_PROVIDER=deepseek
APP_LLM_MODEL=deepseek-chat
APP_LLM_API_KEY=sk-your-api-key-here
APP_LLM_API_BASE=https://api.deepseek.com

# --- 通知 ---
APP_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
APP_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# --- 日志 ---
APP_LOG_LEVEL=INFO

# --- Mock 模式（无外部依赖时使用） ---
APP_MOCK_MODE=true