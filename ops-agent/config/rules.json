{
  "rules": [
    {
      "id": "rule_timeout_001",
      "name": "任务超时检测",
      "description": "任务实际耗时超过预期耗时 N 倍时触发",
      "anomaly_type": "timeout",
      "severity": "P1",
      "condition": "actual_duration > expected_duration * timeout_ratio_threshold",
      "params": { "timeout_ratio_threshold": 1.5 },
      "actions": ["record_anomaly", "trigger_decision_engine"]
    },
    {
      "id": "rule_timeout_002",
      "name": "严重超时检测",
      "description": "任务实际耗时超过预期耗时 3 倍时升级为 P0",
      "anomaly_type": "timeout",
      "severity": "P0",
      "condition": "actual_duration > expected_duration * 3.0",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine", "notify_oncall"]
    },
    {
      "id": "rule_retry_001",
      "name": "重试超限检测",
      "description": "任务重试次数超过阈值",
      "anomaly_type": "task_failure",
      "severity": "P1",
      "condition": "retry_count >= retry_threshold",
      "params": { "retry_threshold": 3 },
      "actions": ["record_anomaly", "trigger_decision_engine"]
    },
    {
      "id": "rule_retry_002",
      "name": "重试严重超限",
      "description": "重试超过 5 次仍未成功，升级处理",
      "anomaly_type": "task_failure",
      "severity": "P0",
      "condition": "retry_count >= 5",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine", "notify_oncall"]
    },
    {
      "id": "rule_resource_001",
      "name": "CPU 高负载检测",
      "description": "集群 CPU 超过高水位阈值",
      "anomaly_type": "resource_contention",
      "severity": "P2",
      "condition": "cluster_cpu_avg >= cpu_high_threshold",
      "params": { "cpu_high_threshold": 85.0 },
      "actions": ["record_anomaly", "trigger_decision_engine"]
    },
    {
      "id": "rule_resource_002",
      "name": "CPU 严重高负载",
      "description": "集群 CPU 超过 95%，触发紧急处理",
      "anomaly_type": "resource_contention",
      "severity": "P1",
      "condition": "cluster_cpu_avg >= 95.0",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine", "notify_oncall"]
    },
    {
      "id": "rule_queue_001",
      "name": "队列积压检测",
      "description": "任务队列深度超过阈值",
      "anomaly_type": "queue_backlog",
      "severity": "P2",
      "condition": "queue_depth >= queue_depth_threshold",
      "params": { "queue_depth_threshold": 100 },
      "actions": ["record_anomaly", "trigger_decision_engine"]
    },
    {
      "id": "rule_queue_002",
      "name": "队列严重积压",
      "description": "队列深度超过 500，需要紧急扩容",
      "anomaly_type": "queue_backlog",
      "severity": "P1",
      "condition": "queue_depth >= 500",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine", "notify_oncall"]
    },
    {
      "id": "rule_error_001",
      "name": "OOM 错误检测",
      "description": "任务 OOM 退出，需要调整资源配额",
      "anomaly_type": "error_pattern",
      "severity": "P1",
      "condition": "error_message contains 'OutOfMemory' or error_message contains 'OOM'",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine"]
    },
    {
      "id": "rule_error_002",
      "name": "连接超时检测",
      "description": "数据库/Hive 连接超时，可能是服务端负载高",
      "anomaly_type": "connection_timeout",
      "severity": "P2",
      "condition": "error_message contains 'timeout' or error_message contains 'Timeout'",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine"]
    },
    {
      "id": "rule_error_003",
      "name": "空指针异常",
      "description": "代码缺陷，需升级开发处理",
      "anomaly_type": "task_failure",
      "severity": "P0",
      "condition": "error_message contains 'NullPointerException' or error_message contains 'NullPointer'",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine", "notify_oncall"]
    },
    {
      "id": "rule_data_001",
      "name": "上游数据未就绪",
      "description": "任务依赖的上游数据表未产出",
      "anomaly_type": "data_not_ready",
      "severity": "P2",
      "condition": "error_message contains 'Table not found' or error_message contains 'Partition not found'",
      "params": {},
      "actions": ["record_anomaly", "trigger_decision_engine"]
    }
  ]
}